---
// Shared frame. All pages render inside this layout so head, nav, and
// footer live in one place.
//
// Brand tokens + type live under /brand/ (vendor-copied by
// scripts/sync-brand.mjs). Components are loaded as ESM only on the
// pages that use them — most pages stay pure HTML/CSS.
//
// Voice rules (see brand/docs/voice.md):
//   - sharp, specific, first-person declarative
//   - sentence case headlines with a period
//   - one headline per page
export interface Props {
  title: string;
  description?: string;
  // The lede sits under the page headline; cooler tone than the H1.
  lede?: string;
  // Mark the active nav item so the link gets aria-current=page.
  // v1 IA (brand docs/ia.md): three surfaces — home, work, writing.
  nav?: 'home' | 'work' | 'writing';
  // Slug of the OG image (writing post id, or 'home' for non-post pages).
  // Resolves to /og/<slug>.light.png + .dark.png generated by
  // scripts/generate-og.mjs at build time. Defaults to 'home'.
  ogImage?: string;
}

// Webfonts — brand v1 "Studio Grotesk" (decisions/brand-v1-studio-grotesk.md):
// Schibsted Grotesk for everything sans (900 carries the display voice),
// Spline Sans Mono for kickers + metadata. Bundled by Astro from
// @fontsource so the site stays self-hosted — no Google Fonts request.
import '@fontsource/schibsted-grotesk/400.css';
import '@fontsource/schibsted-grotesk/500.css';
import '@fontsource/schibsted-grotesk/700.css';
import '@fontsource/schibsted-grotesk/900.css';
import '@fontsource/spline-sans-mono/400.css';
import '@fontsource/spline-sans-mono/500.css';

import EmailSignup from '../components/EmailSignup.astro';

// Wordmark — the brand v1 `felixgeelhaar.` lockup (outlined Schibsted
// Grotesk Black, cobalt full stop). Vite `?raw` inlines the SVG at
// build time so `currentColor` + `--wordmark-accent` follow the theme
// toggle. Source of truth: the synced public/brand/wordmark/wordmark.svg.
import wordmarkRaw from '../../public/brand/wordmark/wordmark.svg?raw';
const wordmarkSvg = wordmarkRaw
  .replace(/<\?xml[^>]*\?>\s*/, '')
  .replace(/<!--[\s\S]*?-->\s*/, '');

const { title, description, lede, nav, ogImage } = Astro.props;
const fullTitle = title === 'Felix Geelhaar' ? title : `${title} — Felix Geelhaar`;
// BASE_URL ends with a slash; use for asset hrefs so paths work under
// both the project-pages prefix and the custom domain root.
const BASE = import.meta.env.BASE_URL;
---
<!DOCTYPE html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <!-- Favicons: brand ships PNG + apple-touch under public/brand/static.
         Browsers pick the best match; no SVG version yet. -->
    <link rel="icon"             type="image/png" sizes="32x32" href={`${BASE}brand/static/favicon-32.png`} />
    <link rel="icon"             type="image/png" sizes="16x16" href={`${BASE}brand/static/favicon-16.png`} />
    <link rel="apple-touch-icon" sizes="180x180"                href={`${BASE}brand/static/apple-touch-icon.png`} />
    <link rel="icon"             type="image/png" sizes="192x192" href={`${BASE}brand/static/icon-192.png`} />
    <link rel="icon"             type="image/png" sizes="512x512" href={`${BASE}brand/static/icon-512.png`} />

    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).toString()} />

    <!-- RSS feed for /writing. Lives at /writing/feed.xml. -->
    <link rel="alternate" type="application/rss+xml" title="Felix Geelhaar — Field Notes" href={`${BASE}writing/feed.xml`} />

    <!-- Brand tokens + type. Loaded once per page; cached after first hit. -->
    <link rel="stylesheet" href={`${BASE}brand/tokens.css`} />
    <link rel="stylesheet" href={`${BASE}brand/type.css`} />
    <link rel="stylesheet" href={`${BASE}brand/responsive.css`} />

    <!-- Site-local overrides + layout. Kept tiny on purpose; brand carries the weight. -->
    <link rel="stylesheet" href={`${BASE}site.css`} />

    <!-- Pre-paint theme set: avoids FOUC where the page flashes light
         before the toggle script runs and swaps to dark. Runs in <head>
         so the data-theme attribute is on <html> before first paint. -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('fg.theme');
          if (stored === 'light' || stored === 'dark') {
            document.documentElement.dataset.theme = stored;
            return;
          }
        } catch (e) {}
        var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme = prefersDark ? 'dark' : 'light';
      })();
    </script>

    <!-- Mermaid: only loaded on pages that actually contain a .mermaid
         block. Theme follows data-theme on <html>. Initialised once;
         re-runs on the existing nodes. Cached after first hit. -->
    <script type="module">
      const blocks = document.querySelectorAll('.mermaid');
      if (blocks.length) {
        const mod = await import('https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.esm.min.mjs');
        const mermaid = mod.default;
        const theme = document.documentElement.dataset.theme === 'dark' ? 'dark' : 'default';
        mermaid.initialize({ startOnLoad: false, theme, securityLevel: 'strict', fontFamily: 'inherit' });
        await mermaid.run({ nodes: blocks });
      }
    </script>

    <!-- Theme toggle: brand's <fg-theme-toggle> custom element. Loads lit
         via importmap so no bundler is needed. -->
    <link rel="stylesheet" href={`${BASE}brand/components/theme-toggle/theme-toggle.css`} />
    <script type="importmap">
      { "imports": { "lit": "https://esm.sh/lit@3" } }
    </script>
    <script type="module" src={`${BASE}brand/components/theme-toggle/theme-toggle.element.js`}></script>

    <!-- Open Graph + Twitter. og:image defaults to the brand's "home"
         sample (light variant). Per-page overrides land later when the
         brand's og.mjs runs per slug. -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).toString()} />
    <meta property="og:title" content={fullTitle} />
    {description && <meta property="og:description" content={description} />}
    {/* OG image: per-post when `ogImage` prop is set, brand sample otherwise. */}
    <meta property="og:image" content={
      ogImage
        ? new URL(`${BASE}og/${ogImage}.light.png`, Astro.site).toString()
        : new URL(`${BASE}brand/dist/og/home.light.png`, Astro.site).toString()
    } />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={
      ogImage
        ? new URL(`${BASE}og/${ogImage}.light.png`, Astro.site).toString()
        : new URL(`${BASE}brand/dist/og/home.light.png`, Astro.site).toString()
    } />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <a href={BASE} class="wordmark" aria-label="Felix Geelhaar — home">
        <!-- Brand v1 wordmark: lowercase `felixgeelhaar.` outlined from
             Schibsted Grotesk Black, cobalt full stop as the mark.
             Inlined so currentColor + --wordmark-accent follow the
             theme toggle. Source: public/brand/wordmark/wordmark.svg. -->
        <Fragment set:html={wordmarkSvg} />
      </a>
      <nav aria-label="Primary">
        <ul role="list">
          <li><a href={`${BASE}work`}    aria-current={nav === 'work'    ? 'page' : undefined}>Work</a></li>
          <li><a href={`${BASE}writing`} aria-current={nav === 'writing' ? 'page' : undefined}>Writing</a></li>
          <li><a class="nav-studio" href="https://klarlabs.de" rel="noopener">klarlabs.de <span aria-hidden="true">↗</span></a></li>
          <li><fg-theme-toggle aria-label="Toggle light or dark theme"></fg-theme-toggle></li>
        </ul>
      </nav>
    </header>

    <main id="main">
      {title && lede && (
        <header class="page-header">
          <h1>{title}</h1>
          <p class="lede">{lede}</p>
        </header>
      )}
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer__signup">
        <EmailSignup
          heading="Field Notes"
          blurb="New essay, roughly weekly. No tracking, no upsell."
          cta="Subscribe"
        />
      </div>
      {/* Primary nav repeats for readers who scrolled past the header
          (serial-position effect, per brand docs/ia.md). */}
      <p>
        <a href={`${BASE}work`}>Work</a> · <a href={`${BASE}writing`}>Writing</a> · <a href="https://klarlabs.de" rel="noopener">klarlabs.de ↗</a>
      </p>
      <p>
        <a href={`${BASE}contact`}>Contact</a> · <a href={`${BASE}writing/feed.xml`}>RSS</a> · <a href="https://github.com/felixgeelhaar" rel="noopener">GitHub</a> · <a href="https://www.linkedin.com/in/felixgeelhaar/" rel="noopener">LinkedIn</a>
      </p>
      <p class="muted">
        © {new Date().getFullYear()} Felix Geelhaar. Built with care and the <a href="https://github.com/felixgeelhaar/brand">brand system</a>.
      </p>
    </footer>
  </body>
</html>

<style is:global>
  /* Site-local fallback if /site.css fails to load. Brand tokens.css
     handles the rest; this file is intentionally tiny. */
  :root { color-scheme: light dark; }
</style>
