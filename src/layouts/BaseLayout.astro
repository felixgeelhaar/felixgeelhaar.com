---
// Shared frame. All pages render inside this layout so head, nav, and
// footer live in one place.
//
// Brand tokens + type live under /brand/ (vendor-copied by
// scripts/sync-brand.mjs). Components are loaded as ESM only on the
// pages that use them — most pages stay pure HTML/CSS.
//
// Voice rules (see brand/docs/voice.md):
//   - sharp, specific, first-person declarative
//   - sentence case headlines with a period
//   - one headline per page
export interface Props {
  title: string;
  description?: string;
  // The lede sits under the page headline; cooler tone than the H1.
  lede?: string;
  // Mark the active nav item so the link gets aria-current=page.
  nav?: 'home' | 'writing' | 'lab' | 'talks' | 'about' | 'contact';
}

const { title, description, lede, nav } = Astro.props;
const fullTitle = title === 'Felix Geelhaar' ? title : `${title} — Felix Geelhaar`;
// BASE_URL ends with a slash; use for asset hrefs so paths work under
// both the project-pages prefix and the custom domain root.
const BASE = import.meta.env.BASE_URL;
---
<!DOCTYPE html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <!-- Favicons: brand ships PNG + apple-touch under public/brand/static.
         Browsers pick the best match; no SVG version yet. -->
    <link rel="icon"             type="image/png" sizes="32x32" href={`${BASE}brand/static/favicon-32.png`} />
    <link rel="icon"             type="image/png" sizes="16x16" href={`${BASE}brand/static/favicon-16.png`} />
    <link rel="apple-touch-icon" sizes="180x180"                href={`${BASE}brand/static/apple-touch-icon.png`} />
    <link rel="icon"             type="image/png" sizes="192x192" href={`${BASE}brand/static/icon-192.png`} />
    <link rel="icon"             type="image/png" sizes="512x512" href={`${BASE}brand/static/icon-512.png`} />

    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).toString()} />

    <!-- Brand tokens + type. Loaded once per page; cached after first hit. -->
    <link rel="stylesheet" href={`${BASE}brand/tokens.css`} />
    <link rel="stylesheet" href={`${BASE}brand/type.css`} />
    <link rel="stylesheet" href={`${BASE}brand/responsive.css`} />

    <!-- Site-local overrides + layout. Kept tiny on purpose; brand carries the weight. -->
    <link rel="stylesheet" href={`${BASE}site.css`} />

    <!-- Pre-paint theme set: avoids FOUC where the page flashes light
         before the toggle script runs and swaps to dark. Runs in <head>
         so the data-theme attribute is on <html> before first paint. -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('fg.theme');
          if (stored === 'light' || stored === 'dark') {
            document.documentElement.dataset.theme = stored;
            return;
          }
        } catch (e) {}
        var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme = prefersDark ? 'dark' : 'light';
      })();
    </script>

    <!-- Theme toggle: brand's <fg-theme-toggle> custom element. Loads lit
         via importmap so no bundler is needed. -->
    <link rel="stylesheet" href={`${BASE}brand/components/theme-toggle/theme-toggle.css`} />
    <script type="importmap">
      { "imports": { "lit": "https://esm.sh/lit@3" } }
    </script>
    <script type="module" src={`${BASE}brand/components/theme-toggle/theme-toggle.element.js`}></script>

    <!-- Open Graph + Twitter. og:image defaults to the brand's "home"
         sample (light variant). Per-page overrides land later when the
         brand's og.mjs runs per slug. -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).toString()} />
    <meta property="og:title" content={fullTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:image" content={new URL(`${BASE}brand/dist/og/home.light.png`, Astro.site).toString()} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL(`${BASE}brand/dist/og/home.light.png`, Astro.site).toString()} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <a href={BASE} class="wordmark" aria-label="Felix Geelhaar — home">
        <!-- Monogram: FG, mono-stroke, rounded caps. Inlined so
             currentColor follows the theme toggle. Accent slash sits
             on the G's spur. Same construction language as the
             slash-bracket symbol but warmer (rounded, less blueprint). -->
        <svg class="wordmark-symbol" aria-hidden="true" focusable="false"
             width="22" height="22" viewBox="0 0 64 64"
             xmlns="http://www.w3.org/2000/svg">
          <g fill="none" stroke="currentColor" stroke-width="6"
             stroke-linecap="round" stroke-linejoin="round">
            <!-- F -->
            <path d="M 10 14 L 10 50"/>
            <path d="M 10 14 L 26 14"/>
            <path d="M 10 30 L 22 30"/>
            <!-- G open C -->
            <path d="M 54 16 L 38 16 L 38 48 L 54 48"/>
          </g>
          <!-- G spur — accent -->
          <path d="M 54 48 L 54 34 L 44 34" fill="none"
                stroke="var(--wordmark-accent, #0050F5)" stroke-width="6"
                stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <!-- Logotype: inlined for the same reason — letterforms now
             follow currentColor; the slash keeps the brand accent. -->
        <svg class="wordmark-logotype" aria-hidden="true" focusable="false"
             width="200" height="22" viewBox="0 0 240 28"
             xmlns="http://www.w3.org/2000/svg">
          <text x="0" y="20" textLength="208" lengthAdjust="spacingAndGlyphs"
                style="font: 500 17px/1 'Geist Mono', ui-monospace, SFMono-Regular, Menlo, monospace; letter-spacing: 0.045em;"
                fill="currentColor">FELIX GEELHAAR</text>
          <text x="214" y="22"
                style="font: 600 26px/1 'Geist Mono', ui-monospace, SFMono-Regular, Menlo, monospace;"
                fill="var(--wordmark-accent, #0050F5)">/</text>
        </svg>
      </a>
      <nav aria-label="Primary">
        <ul role="list">
          <li><a href={`${BASE}writing`} aria-current={nav === 'writing' ? 'page' : undefined}>Writing</a></li>
          <li><a href={`${BASE}lab`}     aria-current={nav === 'lab'     ? 'page' : undefined}>Lab</a></li>
          <li><a href={`${BASE}talks`}   aria-current={nav === 'talks'   ? 'page' : undefined}>Talks</a></li>
          <li><a href={`${BASE}about`}   aria-current={nav === 'about'   ? 'page' : undefined}>About</a></li>
          <li><fg-theme-toggle aria-label="Toggle light or dark theme"></fg-theme-toggle></li>
        </ul>
      </nav>
    </header>

    <main id="main">
      {title && nav && nav !== 'home' && (
        <header class="page-header">
          <h1>{title}</h1>
          {lede && <p class="lede">{lede}</p>}
        </header>
      )}
      <slot />
    </main>

    <footer class="site-footer">
      <p>
        <a href={`${BASE}now`}>Now</a> · <a href={`${BASE}uses`}>Uses</a> · <a href={`${BASE}contact`}>Contact</a>
      </p>
      <p class="muted">
        © {new Date().getFullYear()} Felix Geelhaar. Built with care and the <a href="https://github.com/felixgeelhaar/brand">brand system</a>.
      </p>
    </footer>
  </body>
</html>

<style is:global>
  /* Site-local fallback if /site.css fails to load. Brand tokens.css
     handles the rest; this file is intentionally tiny. */
  :root { color-scheme: light dark; }
</style>
