---
// Buttondown embed form. Reusable wherever email capture earns its
// place (site footer + per-post footer for high-intent moments).
//
// TODO(buttondown): confirm the account slug below matches the live
// Buttondown account. The form posts to the public embed-subscribe
// endpoint, so no API key ships to the client. Subscribers land in
// the Buttondown dashboard regardless of where the form sits.
export interface Props {
  /** Visible label above the input. Tunes the pitch per surface. */
  heading?: string;
  /** Sub-label / value prop sentence. */
  blurb?: string;
  /** Submit-button label. */
  cta?: string;
  /** Buttondown account slug. */
  account?: string;
  /** Compact mode for inline use (no heading/blurb, just the field). */
  compact?: boolean;
}

const {
  heading = 'One quiet email per essay.',
  blurb   = 'New writing in your inbox. No tracking pixel, no upsell, unsubscribe in one click.',
  cta     = 'Subscribe',
  account = 'felixgeelhaar',
  compact = false,
} = Astro.props;

const formAction = `https://buttondown.com/api/emails/embed-subscribe/${account}`;
const popupHref  = `https://buttondown.com/${account}`;
---
<section class={`email-signup${compact ? ' email-signup--compact' : ''}`}>
  {!compact && heading && <h3 class="email-signup__heading">{heading}</h3>}
  {!compact && blurb && <p class="email-signup__blurb">{blurb}</p>}
  <form
    action={formAction}
    method="post"
    target="popupwindow"
    onsubmit={`window.open('${popupHref}', 'popupwindow')`}
    class="email-signup__form"
  >
    <label class="email-signup__label">
      <span class="sr-only">Email address</span>
      <input
        type="email"
        name="email"
        required
        placeholder="you@domain.com"
        autocomplete="email"
        class="email-signup__input"
      />
    </label>
    <input type="hidden" name="embed" value="1" />
    <button type="submit" class="email-signup__submit">{cta}</button>
  </form>
</section>

<style>
  .email-signup {
    border: 1px solid var(--color-line, #E5E5E5);
    background: var(--color-bg-elevated, #FFFFFF);
    padding: 1.5rem;
    border-radius: 6px;
  }
  .email-signup--compact { padding: 1rem; }

  .email-signup__heading {
    margin: 0 0 0.5rem;
    font-size: 1.05rem;
    letter-spacing: -0.005em;
  }
  .email-signup__blurb {
    margin: 0 0 1rem;
    color: var(--color-fg-muted, #525252);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .email-signup__form {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .email-signup__label { flex: 1 1 14rem; min-width: 0; }

  .email-signup__input {
    width: 100%;
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--color-line-strong, #C9C9C9);
    border-radius: 4px;
    font: 400 0.95rem/1 var(--font-sans, system-ui);
    background: var(--color-bg, #FAFAFA);
    color: var(--color-fg, #0A0A0A);
  }
  .email-signup__input:focus {
    outline: 2px solid var(--color-accent, #0050F5);
    outline-offset: 1px;
    border-color: var(--color-accent, #0050F5);
  }

  .email-signup__submit {
    appearance: none;
    border: 1px solid var(--color-accent, #0050F5);
    background: var(--color-accent, #0050F5);
    color: #FFFFFF;
    font: 500 0.9rem/1 var(--font-mono, ui-monospace, monospace);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.6rem 1.1rem;
    border-radius: 4px;
    cursor: pointer;
    transition: background 120ms ease-out;
  }
  .email-signup__submit:hover { background: var(--color-accent-hover, #0040C8); }
  .email-signup__submit:focus-visible {
    outline: 2px solid var(--color-fg, #0A0A0A);
    outline-offset: 2px;
  }

  .sr-only {
    position: absolute; width: 1px; height: 1px;
    padding: 0; margin: -1px; overflow: hidden;
    clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
  }
</style>
