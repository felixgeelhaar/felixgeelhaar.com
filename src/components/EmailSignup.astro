---
// Buttondown embed form, AJAX-submitted to avoid the default popup
// confirmation that costs ~20–30% completions on mobile. Inline
// confirmation replaces the form on success.
//
// TODO(buttondown): confirm the `account` slug matches the live
// Buttondown account. Submission goes to the public embed-subscribe
// endpoint — no API key on the client.
export interface Props {
  /** Visible label above the input. Tunes the pitch per surface. */
  heading?: string;
  /** Sub-label / value prop sentence. */
  blurb?: string;
  /** Submit-button label. */
  cta?: string;
  /** Buttondown account slug. */
  account?: string;
  /** Compact mode: no heading/blurb, no recent-titles list. */
  compact?: boolean;
  /** Recent post titles + hrefs, shown under the form as proof of cadence + quality. */
  recentTitles?: Array<{ title: string; href: string }>;
}

const {
  heading = 'Field notes on shipping with agents — in your inbox.',
  blurb   = 'Roughly weekly. No tracking, no upsell. Unsubscribe in one click.',
  cta     = 'Subscribe',
  account = 'felixgeelhaar',
  compact = false,
  recentTitles = [],
} = Astro.props;

const formAction = `https://buttondown.com/api/emails/embed-subscribe/${account}`;
---
<section class={`email-signup${compact ? ' email-signup--compact' : ''}`} data-signup>
  {!compact && heading && <h3 class="email-signup__heading">{heading}</h3>}
  {!compact && blurb && <p class="email-signup__blurb">{blurb}</p>}

  <form
    action={formAction}
    method="post"
    class="email-signup__form"
    data-signup-form
  >
    <label class="email-signup__label">
      <span class="sr-only">Email address</span>
      <input
        type="email"
        name="email"
        required
        placeholder="you@domain.com"
        autocomplete="email"
        class="email-signup__input"
      />
    </label>
    <input type="hidden" name="embed" value="1" />
    <button type="submit" class="email-signup__submit">{cta}</button>
  </form>

  <p class="email-signup__confirm" data-signup-confirm hidden>
    Subscribed. Check your inbox for a confirmation link.
  </p>

  {!compact && recentTitles.length > 0 && (
    <div class="email-signup__recent">
      <p class="email-signup__recent-heading">Recent issues</p>
      <ul>
        {recentTitles.map((t) => (
          <li><a href={t.href}>{t.title}</a></li>
        ))}
      </ul>
    </div>
  )}
</section>

<style>
  .email-signup {
    border: 1px solid var(--color-line, #E5E5E5);
    background: var(--color-bg-elevated, #FFFFFF);
    padding: 1.5rem;
    border-radius: 6px;
  }
  .email-signup--compact { padding: 1rem; }

  .email-signup__heading {
    margin: 0 0 0.5rem;
    font-size: 1.05rem;
    letter-spacing: -0.005em;
  }
  .email-signup__blurb {
    margin: 0 0 1rem;
    color: var(--color-fg-muted, #525252);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .email-signup__form {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .email-signup__label { flex: 1 1 14rem; min-width: 0; }

  .email-signup__input {
    width: 100%;
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--color-line-strong, #C9C9C9);
    border-radius: 4px;
    font: 400 0.95rem/1 var(--font-sans, system-ui);
    background: var(--color-bg, #FAFAFA);
    color: var(--color-fg, #0A0A0A);
  }
  .email-signup__input:focus {
    outline: 2px solid var(--color-accent, #0050F5);
    outline-offset: 1px;
    border-color: var(--color-accent, #0050F5);
  }

  .email-signup__submit {
    appearance: none;
    border: 1px solid var(--color-accent, #0050F5);
    background: var(--color-accent, #0050F5);
    color: #FFFFFF;
    font: 500 0.9rem/1 var(--font-mono, ui-monospace, monospace);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.6rem 1.1rem;
    border-radius: 4px;
    cursor: pointer;
    transition: background 120ms ease-out;
  }
  .email-signup__submit:hover { background: var(--color-accent-hover, #0040C8); }
  .email-signup__submit:focus-visible {
    outline: 2px solid var(--color-fg, #0A0A0A);
    outline-offset: 2px;
  }

  .email-signup__confirm {
    margin: 0.5rem 0 0;
    padding: 0.65rem 0.85rem;
    background: var(--color-bg, #FAFAFA);
    border: 1px solid var(--color-accent, #0050F5);
    border-radius: 4px;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.85rem;
    color: var(--color-fg, #0A0A0A);
  }

  .email-signup__recent {
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px dashed var(--color-line, #E5E5E5);
  }
  .email-signup__recent-heading {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-fg-muted, #525252);
    margin: 0 0 0.55rem;
  }
  .email-signup__recent ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.3rem;
  }
  .email-signup__recent a {
    font-size: 0.9rem;
    line-height: 1.35;
  }

  .sr-only {
    position: absolute; width: 1px; height: 1px;
    padding: 0; margin: -1px; overflow: hidden;
    clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
  }
</style>

<script is:inline>
  // AJAX submit for every .email-signup form on the page. Buttondown's
  // embed endpoint doesn't return CORS headers, so we POST with
  // mode: 'no-cors' (opaque response) and show the inline confirmation
  // optimistically. The address is still subscribed server-side.
  document.querySelectorAll('[data-signup-form]').forEach(function (form) {
    form.addEventListener('submit', async function (event) {
      event.preventDefault();
      var section = form.closest('[data-signup]');
      var confirm = section ? section.querySelector('[data-signup-confirm]') : null;
      var submit = form.querySelector('button[type="submit"]');
      if (submit) { submit.disabled = true; submit.textContent = 'Subscribing…'; }
      try {
        await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          mode: 'no-cors',
        });
      } catch (err) {
        // no-cors means we can't read errors; treat all completions
        // as success and let Buttondown's confirmation email handle
        // edge cases.
      }
      form.setAttribute('hidden', '');
      if (confirm) confirm.removeAttribute('hidden');
    });
  });
</script>
