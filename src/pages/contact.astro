---
import BaseLayout from '../layouts/BaseLayout.astro';
const BASE = import.meta.env.BASE_URL;
---
<BaseLayout
  title="Contact"
  description="Email, GitHub, LinkedIn. No web form."
  lede="No web form. Email or a short LinkedIn note is the fastest path."
  nav="contact"
>
  <section class="cta-grid">
    <a class="cta" href="mailto:hello@felixgeelhaar.com">
      <h3>Email</h3>
      <p>hello@felixgeelhaar.com</p>
    </a>
    <a class="cta" href="https://github.com/felixgeelhaar">
      <h3>GitHub</h3>
      <p>Issues on the OSS projects get the fastest answer there.</p>
    </a>
    <a class="cta" href="https://www.linkedin.com/in/felixgeelhaar/">
      <h3>LinkedIn</h3>
      <p>For inbound that needs a paper trail.</p>
    </a>
  </section>

  <section class="prose">
    <p>
      I read everything; I do not always reply quickly. Specific beats vague &mdash; one paragraph
      with the actual question helps.
    </p>
  </section>
</BaseLayout>
