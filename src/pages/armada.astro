---
import BaseLayout from '../layouts/BaseLayout.astro';
const BASE = import.meta.env.BASE_URL;

const ARMADA = {
  // armada.run is the canonical commercial site. This page is the
  // intro for personal-site visitors who arrive from a writing post
  // or the primary nav. The full pitch (screenshots, pricing, social
  // proof, full feature list) lives on armada.run.
  productSite: 'https://armada.run',
  marketplaceUrl: 'https://marketplace.atlassian.com/apps/2348071004/armada-campaign-manager-for-jira',
  github: 'https://github.com/felixgeelhaar/armada',
  version: 'v4.2',
  trialDays: 30,
};

const compare = [
  {
    concern: 'Determinism',
    agent: 'Strategy varies between runs. Auditable only if you snapshot prompts and responses.',
    armada: 'Same plan from same inputs. Strategy choice per team is data, not a model call.',
  },
  {
    concern: 'Permission model',
    agent: 'Acts with whatever Jira credentials its MCP token holds — usually a service account.',
    armada: 'Forge app with scoped grants (read:jira-work, write:jira-work, etc.) declared in manifest.',
  },
  {
    concern: 'Persistent state',
    agent: 'Lives in the chat session that created it. Closing the chat closes the project.',
    armada: 'Campaign state stored as a property on the parent Jira issue. Re-open next quarter, still there.',
  },
  {
    concern: 'Audit trail',
    agent: '"User X did this" without the why, unless you separately log prompts + responses.',
    armada: 'Every action logged through Atlassian audit framework. Approvals, recalls, nudges, transitions.',
  },
  {
    concern: 'Approval + recall',
    agent: '"Approvals" are vibes. Recall is "agent, please undo that."',
    armada: 'First-class approver allowlist. Recall path with audit comments + safety rails.',
  },
  {
    concern: 'In-product UI',
    agent: 'Assumes every stakeholder lives in the chat. Most stakeholders don\'t.',
    armada: 'Jira issue panel. Campaign owners see status without opening another tool.',
  },
  {
    concern: 'Templates + multi-stage',
    agent: 'Re-derived from prose each time. Structure drifts.',
    armada: 'Templates saved as data. Multi-stage rollouts defined and persisted on the campaign object.',
  },
];
---
<BaseLayout
  title="Armada — Campaign orchestration for Jira"
  description="Turn one parent Jira issue into a tracked, audited, governable campaign across 50+ teams. Atlassian Marketplace app. Full product site: armada.run."
  nav="armada"
  ogImage="armada"
>
  <!-- Hero -->
  <section class="armada-hero">
    <p class="armada-eyebrow">ATLASSIAN MARKETPLACE · {ARMADA.version}</p>
    <h1>Every 200-team rollout ends in a Google Sheet. Fix it in Jira.</h1>
    <p class="lede">
      Armada turns Jira into a command center for large-scale initiatives — security patches,
      migrations, compliance audits, incident coordination. Fan out from one parent issue to
      every team that needs work, govern the rollout, recall safely. Built as a Forge app so
      it runs inside Jira's permission and audit model.
    </p>
    <div class="armada-cta-row">
      <a href={ARMADA.marketplaceUrl} class="btn btn--accent" rel="noopener">
        Install from Marketplace
      </a>
      <a href={ARMADA.productSite} class="armada-link-text" rel="noopener">
        Full feature tour, screenshots &amp; pricing &rarr; armada.run
      </a>
    </div>
    <p class="armada-trial-note">
      Free {ARMADA.trialDays}-day trial via the Atlassian Marketplace. Source on <a href={ARMADA.github} rel="noopener">GitHub</a>.
    </p>
  </section>

  <!-- Comparison: vs ad-hoc agent. The unique signal this page carries —
       no other Marketplace listing pre-empts the "just use Claude" objection. -->
  <section class="armada-section">
    <h2>But couldn't an agent just do this?</h2>
    <p class="armada-section-lede">
      Fair question. The 2026 default move for "fan out across 87 teams" is "ask Claude (or GPT,
      or Cursor) to do it via Jira's MCP." For one-off, exploratory work, the agent path is the
      right tool. For anything that recurs, scales, or has consequences, the trade flips.
    </p>
    <div class="armada-compare">
      <div class="armada-compare__head">
        <div>Concern</div>
        <div>Ad-hoc agent via Jira MCP</div>
        <div>Armada</div>
      </div>
      {compare.map((row) => (
        <div class="armada-compare__row">
          <div class="armada-compare__concern">{row.concern}</div>
          <div class="armada-compare__agent">{row.agent}</div>
          <div class="armada-compare__armada">{row.armada}</div>
        </div>
      ))}
    </div>
    <p class="armada-compare__close">
      <strong>The honest decision tree:</strong> one-off campaigns &rarr; use the agent.
      Recurring, scaled, or audited campaigns &rarr; use the deterministic, scope-bounded,
      audit-logged app. The two compose: agent drafts the skeleton, Armada governs the
      execution.
    </p>
    <p class="armada-compare__longread">
      Long-form argument:
      <a href={`${BASE}writing/jira-campaign-orchestration`}>Every 200-team rollout ends in a Google Sheet. Fix it in Jira.</a>
    </p>
  </section>

  <!-- Close -->
  <section class="armada-section armada-getit">
    <h2>Get Armada</h2>
    <p>
      Install from the Atlassian Marketplace &mdash; {ARMADA.trialDays}-day free trial, Forge app
      runs inside your Jira tenant, Atlassian's permission and audit model. For the full feature
      tour, screenshots, pricing tiers, and case studies, head to <a href={ARMADA.productSite} rel="noopener">armada.run</a>.
    </p>
    <div class="armada-cta-row">
      <a href={ARMADA.marketplaceUrl} class="btn btn--accent" rel="noopener">
        Install from Marketplace
      </a>
      <a href={ARMADA.productSite} class="armada-link-text" rel="noopener">
        armada.run &rarr;
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .armada-hero { padding: 2rem 0 3rem; }
  .armada-eyebrow {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    color: var(--color-fg-muted, #525252);
    margin-bottom: 0.75rem;
  }
  .armada-hero h1 { letter-spacing: -0.015em; margin-bottom: 1rem; }
  .armada-hero .lede { max-width: 56ch; }
  .armada-cta-row {
    display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; margin-top: 1.5rem;
  }
  .armada-link-text {
    font: 500 0.9rem/1 var(--font-mono, ui-monospace, monospace);
    letter-spacing: 0.04em;
    color: var(--color-fg-muted, #525252);
    text-decoration: none;
    border-bottom: 1px dotted var(--color-line-strong, #C9C9C9);
    padding-bottom: 2px;
  }
  .armada-link-text:hover {
    color: var(--color-fg, #0A0A0A);
    border-bottom-color: var(--color-fg, #0A0A0A);
  }
  .armada-trial-note {
    margin-top: 0.75rem;
    font-size: 0.85rem;
    color: var(--color-fg-muted, #525252);
  }

  .armada-section {
    padding: 2rem 0;
    border-top: 1px solid var(--color-line, #E5E5E5);
  }
  .armada-section h2 { margin-bottom: 1rem; }
  .armada-section-lede {
    color: var(--color-fg-muted, #525252);
    max-width: 60ch;
    margin-bottom: 1.5rem;
  }

  .armada-compare {
    border: 1px solid var(--color-line, #E5E5E5);
    overflow-x: auto;
  }
  .armada-compare__head,
  .armada-compare__row {
    display: grid;
    grid-template-columns: 1.2fr 2fr 2fr;
    gap: 1rem;
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--color-line, #E5E5E5);
  }
  .armada-compare__head {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-fg-muted, #525252);
    background: var(--color-bg-elevated, #FFFFFF);
  }
  .armada-compare__row:last-of-type { border-bottom: 0; }
  .armada-compare__concern {
    font-weight: 600; color: var(--color-fg, #0A0A0A);
  }
  .armada-compare__agent { color: var(--color-fg-muted, #525252); }
  .armada-compare__armada { color: var(--color-fg, #0A0A0A); }
  .armada-compare__close {
    margin-top: 1.5rem;
    line-height: 1.55;
  }
  .armada-compare__longread {
    margin-top: 0.75rem;
    font-size: 0.9rem;
    color: var(--color-fg-muted, #525252);
  }

  .armada-getit { padding-bottom: 3rem; }
  .armada-getit p { line-height: 1.55; margin-bottom: 1.25rem; max-width: 60ch; }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: 0.6rem 1.1rem;
    border-radius: 6px;
    font: 500 0.9rem/1 var(--font-mono, ui-monospace, monospace);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    border: 1px solid;
    transition: all 120ms ease-out;
  }
  .btn--accent {
    background: var(--color-accent, #0050F5);
    color: #FFFFFF;
    border-color: var(--color-accent, #0050F5);
  }
  .btn--accent:hover { background: var(--color-accent-hover, #0040C8); }
</style>
