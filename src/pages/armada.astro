---
import BaseLayout from '../layouts/BaseLayout.astro';
const BASE = import.meta.env.BASE_URL;

// TODO(armada): replace these placeholders with the live values when
// confirmed. Marketplace listing URL is the most important one for
// the install CTA; pricing copy can stay generic until tiers stabilise.
const ARMADA = {
  marketplaceUrl: 'https://marketplace.atlassian.com/apps/1241024/armada',
  github: 'https://github.com/felixgeelhaar/armada',
  docs: 'https://github.com/felixgeelhaar/armada#documentation',
  version: 'v4.2',
  trialDays: 30,
};

const compare = [
  {
    concern: 'Determinism',
    agent: 'Strategy varies between runs. Auditable only if you snapshot prompts and responses.',
    armada: 'Same plan from same inputs. Strategy choice per team is data, not a model call.',
  },
  {
    concern: 'Permission model',
    agent: 'Acts with whatever Jira credentials its MCP token holds — usually a service account.',
    armada: 'Forge app with scoped grants (read:jira-work, write:jira-work, etc.) declared in manifest.',
  },
  {
    concern: 'Persistent state',
    agent: 'Lives in the chat session that created it. Closing the chat closes the project.',
    armada: 'Campaign state stored as a property on the parent Jira issue. Re-open next quarter, still there.',
  },
  {
    concern: 'Audit trail',
    agent: '"User X did this" without the why, unless you separately log prompts + responses.',
    armada: 'Every action logged through Atlassian audit framework. Approvals, recalls, nudges, transitions.',
  },
  {
    concern: 'Approval + recall',
    agent: '"Approvals" are vibes. Recall is "agent, please undo that."',
    armada: 'First-class approver allowlist. Recall path with audit comments + safety rails.',
  },
  {
    concern: 'In-product UI',
    agent: 'Assumes every stakeholder lives in the chat. Most stakeholders don\'t.',
    armada: 'Jira issue panel. Campaign owners see status without opening another tool.',
  },
  {
    concern: 'Templates + multi-stage',
    agent: 'Re-derived from prose each time. Structure drifts.',
    armada: 'Templates saved as data. Multi-stage rollouts defined and persisted on the campaign object.',
  },
];

const useCases = [
  {
    title: 'Security patch rollout',
    detail: 'CVE drops. Patch needs to ship across every service touching the affected library — across 87 teams in 12 projects. Fan-out with health checks, approval gates per tier, recall safety if the patch regresses.',
  },
  {
    title: 'Platform migration',
    detail: 'Move 142 services from in-house auth to OIDC. Multi-stage rollout (tier-1, tier-2, tier-3), per-team adoption tracking, drift detection when teams skip stages.',
  },
  {
    title: 'Compliance audit campaign',
    detail: 'Quarterly SOC 2 evidence collection across 200+ repos. Templates reused each quarter, evidence-of-completion linked to parent campaign, audit trail defensible without a spreadsheet.',
  },
  {
    title: 'Incident response coordination',
    detail: 'Major incident requires action across multiple teams: rollback service A, patch service B, draft RCA for service C. Fan-out with live mission control + auto-nudge for stalled teams.',
  },
];
---
<BaseLayout
  title="Armada — Campaign orchestration for Jira"
  description="Turn one parent Jira issue into a tracked, audited, governable campaign across 50+ teams. Fan-out engine, live mission control, approval gates, recall safety, templates, multi-stage rollouts. Atlassian Marketplace app."
  nav="home"
>
  <!-- Hero -->
  <section class="armada-hero">
    <p class="armada-eyebrow">ATLASSIAN MARKETPLACE · {ARMADA.version}</p>
    <h1>Jira can run a 200-team campaign. The defaults can't.</h1>
    <p class="lede">
      Armada turns Jira into a command center for large-scale initiatives — security patches,
      migrations, compliance audits, incident coordination. Fan out from one parent issue to
      every team that needs work, govern the rollout, recall safely when you need to. Built as
      a Forge app so it runs inside Jira's own permission and audit model.
    </p>
    <div class="armada-cta-row">
      <a href={ARMADA.marketplaceUrl} class="btn btn--accent" rel="noopener">
        Install from Marketplace
      </a>
      <a href={ARMADA.github} class="btn btn--ghost" rel="noopener">
        Source on GitHub
      </a>
    </div>
    <p class="armada-trial-note">
      Free {ARMADA.trialDays}-day trial. Paid plans via Atlassian Marketplace.
    </p>
  </section>

  <!-- What it does -->
  <section class="armada-section">
    <h2>What it does</h2>
    <ul class="armada-features">
      <li>
        <strong>Smart fan-out.</strong> One parent issue produces N children across N teams. Each
        child lands in the right project, in the right shape (sub-task, linked task, Epic child)
        without the campaign owner needing to know each team's layout.
      </li>
      <li>
        <strong>Live mission control.</strong> Single rollup view: weighted progress, blocked vs
        review vs done, per-team timeline. Stalled-team detection with auto-nudge.
      </li>
      <li>
        <strong>Fleet persistence.</strong> Team → project mapping stored, versioned, importable
        from Compass with dedupe and validation.
      </li>
      <li>
        <strong>Safety rails.</strong> Pre-flight health checks before launch. Recall path that
        transitions + unlinks children with audit comments instead of bulk-deleting.
      </li>
      <li>
        <strong>Approval gates.</strong> Named approver allowlist with audit-comment confirmations
        for the launches that warrant it.
      </li>
      <li>
        <strong>Templates.</strong> The quarterly compliance campaign you run every quarter is a
        template you reapply with variable substitution. Not a campaign someone rebuilds from
        memory each time.
      </li>
      <li>
        <strong>Multi-stage rollouts.</strong> Wave 1 / wave 2 / wave 3 defined on the campaign,
        gated, persisted, advanceable from the UI with audit-tracked transitions.
      </li>
      <li>
        <strong>Compass integration.</strong> Component pages show campaign status. Scorecards push
        metrics. Team discovery pulls services from Compass. Campaign indexing for fast lookups.
      </li>
    </ul>
  </section>

  <!-- Use cases -->
  <section class="armada-section">
    <h2>Where it fits</h2>
    <div class="armada-usecases">
      {useCases.map((uc) => (
        <article class="armada-usecase">
          <h3>{uc.title}</h3>
          <p>{uc.detail}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- Comparison: vs ad-hoc agent -->
  <section class="armada-section">
    <h2>But couldn't an agent just do this?</h2>
    <p class="armada-section-lede">
      Fair question. The 2026 default move for "fan out across 87 teams" is "ask Claude (or GPT,
      or Cursor) to do it via Jira's MCP." For one-off, exploratory work, the agent path is the
      right tool. For anything that recurs, scales, or has consequences, the trade flips.
    </p>
    <div class="armada-compare">
      <div class="armada-compare__head">
        <div>Concern</div>
        <div>Ad-hoc agent via Jira MCP</div>
        <div>Armada</div>
      </div>
      {compare.map((row) => (
        <div class="armada-compare__row">
          <div class="armada-compare__concern">{row.concern}</div>
          <div class="armada-compare__agent">{row.agent}</div>
          <div class="armada-compare__armada">{row.armada}</div>
        </div>
      ))}
    </div>
    <p class="armada-compare__close">
      <strong>The honest decision tree:</strong> one-off campaigns → use the agent.
      Recurring, scaled, or audited campaigns → use the deterministic, scope-bounded,
      audit-logged app. The two compose: agent drafts the skeleton, Armada governs the
      execution.
    </p>
    <p class="armada-compare__longread">
      Long-form argument:
      <a href={`${BASE}writing/jira-campaign-orchestration`}>Jira can run a 200-team campaign. The defaults can't.</a>
    </p>
  </section>

  <!-- Who it's for -->
  <section class="armada-section">
    <h2>Who it's for</h2>
    <ul class="armada-buyers">
      <li><strong>Security program managers</strong> coordinating CVE patch rollouts across product engineering.</li>
      <li><strong>Platform / infrastructure TPMs</strong> running multi-service migrations with per-team adoption tracking.</li>
      <li><strong>Compliance leads</strong> orchestrating quarterly evidence collection across hundreds of repos.</li>
      <li><strong>Engineering operations</strong> teams coordinating cross-org initiatives that don't fit a single project board.</li>
    </ul>
  </section>

  <!-- Get it -->
  <section class="armada-section armada-getit">
    <h2>Get it</h2>
    <p>
      Install Armada in your Jira site through the Atlassian Marketplace. {ARMADA.trialDays}-day
      free trial. Forge app — runs inside your Jira tenant, no third-party data hosting.
    </p>
    <div class="armada-cta-row">
      <a href={ARMADA.marketplaceUrl} class="btn btn--accent" rel="noopener">
        Install from Marketplace
      </a>
      <a href={ARMADA.docs} class="btn btn--ghost" rel="noopener">
        Documentation
      </a>
      <a href={ARMADA.github} class="btn btn--ghost" rel="noopener">
        Source on GitHub
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .armada-hero { padding: 2rem 0 3rem; }
  .armada-eyebrow {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    color: var(--color-fg-muted, #525252);
    margin-bottom: 0.75rem;
  }
  .armada-hero h1 { letter-spacing: -0.015em; margin-bottom: 1rem; }
  .armada-hero .lede { max-width: 56ch; }
  .armada-cta-row {
    display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem;
  }
  .armada-trial-note {
    margin-top: 0.75rem;
    font-size: 0.85rem;
    color: var(--color-fg-muted, #525252);
  }

  .armada-section {
    padding: 2rem 0;
    border-top: 1px solid var(--color-line, #E5E5E5);
  }
  .armada-section h2 { margin-bottom: 1rem; }
  .armada-section-lede {
    color: var(--color-fg-muted, #525252);
    max-width: 60ch;
    margin-bottom: 1.5rem;
  }

  .armada-features { list-style: none; padding: 0; display: grid; gap: 1rem; }
  .armada-features li {
    padding-left: 0;
    line-height: 1.55;
  }
  .armada-features strong { color: var(--color-fg, #0A0A0A); }

  .armada-usecases {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: 1rem;
  }
  .armada-usecase {
    border: 1px solid var(--color-line, #E5E5E5);
    padding: 1.25rem;
    background: var(--color-bg-elevated, #FFFFFF);
  }
  .armada-usecase h3 {
    font-size: 1rem;
    font-family: var(--font-mono, ui-monospace, monospace);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
  }
  .armada-usecase p {
    color: var(--color-fg-muted, #525252);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .armada-compare {
    border: 1px solid var(--color-line, #E5E5E5);
    overflow-x: auto;
  }
  .armada-compare__head,
  .armada-compare__row {
    display: grid;
    grid-template-columns: 1.2fr 2fr 2fr;
    gap: 1rem;
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--color-line, #E5E5E5);
  }
  .armada-compare__head {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-fg-muted, #525252);
    background: var(--color-bg-elevated, #FFFFFF);
  }
  .armada-compare__row:last-of-type { border-bottom: 0; }
  .armada-compare__concern {
    font-weight: 600; color: var(--color-fg, #0A0A0A);
  }
  .armada-compare__agent { color: var(--color-fg-muted, #525252); }
  .armada-compare__armada { color: var(--color-fg, #0A0A0A); }
  .armada-compare__close {
    margin-top: 1.5rem;
    line-height: 1.55;
  }
  .armada-compare__longread {
    margin-top: 0.75rem;
    font-size: 0.9rem;
    color: var(--color-fg-muted, #525252);
  }

  .armada-buyers { padding-left: 1.25rem; line-height: 1.6; }
  .armada-buyers strong { color: var(--color-fg, #0A0A0A); }

  .armada-getit { padding-bottom: 3rem; }

  /* Button helpers — minimal, brand tokens with safe fallbacks. */
  .btn {
    display: inline-flex;
    align-items: center;
    padding: 0.6rem 1.1rem;
    border-radius: 6px;
    font: 500 0.9rem/1 var(--font-mono, ui-monospace, monospace);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    border: 1px solid;
    transition: all 120ms ease-out;
  }
  .btn--accent {
    background: var(--color-accent, #0050F5);
    color: #FFFFFF;
    border-color: var(--color-accent, #0050F5);
  }
  .btn--accent:hover { background: var(--color-accent-hover, #0040C8); }
  .btn--ghost {
    background: transparent;
    color: var(--color-fg, #0A0A0A);
    border-color: var(--color-line-strong, #C9C9C9);
  }
  .btn--ghost:hover { border-color: var(--color-fg, #0A0A0A); }
</style>
