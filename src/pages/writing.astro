---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const BASE = import.meta.env.BASE_URL;

// Pull every non-draft essay, newest first.
const all = await getCollection('writing', ({ data }) => !data.draft);
const entries = all.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const fmtDate = (d: Date) =>
  d.toISOString().slice(0, 10); // YYYY-MM-DD; sentence-case-friendly

// Filter pill counts. Computed at build time; rendered once.
const counts = {
  all: entries.length,
  essay: entries.filter((e) => e.data.kind === 'essay').length,
  project: entries.filter((e) => e.data.kind === 'project').length,
};
---
<BaseLayout
  title="Writing — Field Notes"
  description="Field Notes — long-form essays on shipping software with AI agents. Plan-of-record, evidence layers, agent runtimes, and the anti-patterns engineering teams ship when a model is in the loop."
  lede="Field Notes. Long-form essays on shipping software with AI agents — plan-of-record, evidence layers, agent runtimes, and the anti-patterns engineering teams ship when a model is in the loop."
  nav="writing"
  ogImage="writing"
>
  {entries.length === 0 ? (
    <section class="prose">
      <p>No essays yet. The first ones land here. Topics queued on <a href={`${BASE}now`}>/now</a>.</p>
    </section>
  ) : (
    <>
      <section class="start-here">
        <h2 class="start-here__heading">Start here</h2>
        <p class="start-here__lede">
          Three reader-paths through the 14 posts. Pick the one closest to your job today.
        </p>
        <div class="start-here__grid">
          <article class="start-here__card">
            <p class="start-here__role">Eng leader adopting AI agents</p>
            <ol>
              <li><a href={`${BASE}writing/21-patterns-shipping-with-agents`}>21 patterns I keep seeing in teams shipping with AI coding agents.</a></li>
              <li><a href={`${BASE}writing/deploy-release-launch`}>Deploy is not release. Release is not launch.</a></li>
              <li><a href={`${BASE}writing/cognitive-stack`}>An agent runtime is five primitives. Most fake at least three.</a></li>
            </ol>
          </article>
          <article class="start-here__card">
            <p class="start-here__role">Engineer building agent tooling</p>
            <ol>
              <li><a href={`${BASE}writing/agents-forget-plan-remembers`}>Agents forget. The plan should remember.</a></li>
              <li><a href={`${BASE}writing/plan-and-evidence-two-memories`}>Agents forget two ways. Most memory tools only fix one.</a></li>
              <li><a href={`${BASE}writing/llm-resilience-playbook`}>LLM calls broke your resilience playbook. Add these back.</a></li>
            </ol>
          </article>
          <article class="start-here__card">
            <p class="start-here__role">Security / platform / TPM at scale</p>
            <ol>
              <li><a href={`${BASE}writing/security-scanner-ai-blind`}>Your security scanner can't see your AI code.</a></li>
              <li><a href={`${BASE}writing/jira-campaign-orchestration`}>Every 200-team rollout ends in a Google Sheet. Fix it in Jira.</a></li>
              <li><a href={`${BASE}writing/local-first-coding-agents`}>Cloud coding agents read your repo. Yours doesn't have to.</a></li>
            </ol>
          </article>
        </div>
      </section>

      <div class="filter-bar" role="group" aria-label="Filter posts by kind">
        <button type="button" class="filter-pill is-active" data-filter="all" aria-pressed="true">
          All <span class="filter-count">{counts.all}</span>
        </button>
        <button type="button" class="filter-pill" data-filter="essay" aria-pressed="false">
          Essays <span class="filter-count">{counts.essay}</span>
        </button>
        <button type="button" class="filter-pill" data-filter="project" aria-pressed="false">
          Projects <span class="filter-count">{counts.project}</span>
        </button>
      </div>

      <ol class="entry-list" id="writing-list">
        {entries.map((e) => (
          <li class="entry" data-kind={e.data.kind} data-project={e.data.project ?? ''}>
            <div class="entry-meta">
              <span>{e.data.kind === 'project' ? (e.data.project ?? 'PROJECT').toUpperCase() : 'ESSAY'}</span>
              <span>{fmtDate(e.data.date)}</span>
              {e.data.readingMins && <span>{e.data.readingMins} min</span>}
            </div>
            <h2><a href={`${BASE}writing/${e.id}`}>{e.data.title}</a></h2>
            <p class="entry-summary">{e.data.summary}</p>
          </li>
        ))}
      </ol>

      <p class="filter-empty" id="filter-empty" hidden>
        No posts in this filter yet.
      </p>
    </>
  )}
</BaseLayout>

<style>
  /* Start-here block: three reader-paths into the portfolio. Sits
     above the filter bar so a cold reader picks a path before the
     full list overwhelms them. */
  .start-here {
    margin: 0 0 2.5rem;
    padding: 1.5rem;
    background: var(--color-bg-elevated, #FFFFFF);
    border: 1px solid var(--color-line, #E5E5E5);
    border-radius: 8px;
  }
  .start-here__heading {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.8rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-fg-muted, #525252);
    margin: 0 0 0.5rem;
  }
  .start-here__lede {
    color: var(--color-fg-muted, #525252);
    margin: 0 0 1.25rem;
    font-size: 0.95rem;
  }
  .start-here__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1.25rem;
  }
  .start-here__card {
    background: var(--color-bg, #FAFAFA);
    border: 1px solid var(--color-line, #E5E5E5);
    padding: 1rem 1.1rem 1.1rem;
    border-radius: 6px;
  }
  .start-here__role {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-fg, #0A0A0A);
    margin: 0 0 0.65rem;
  }
  .start-here__card ol {
    margin: 0;
    padding-left: 1.1rem;
    display: grid;
    gap: 0.45rem;
  }
  .start-here__card a { font-size: 0.92rem; line-height: 1.35; }

  /* Filter bar — sits above the entry list. Pill row with counts. */
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 2rem;
  }

  .filter-pill {
    appearance: none;
    border: 1px solid var(--color-line, #E5E5E5);
    background: var(--color-bg-elevated, #FFFFFF);
    color: var(--color-fg-muted, #525252);
    font: 500 0.85rem/1 var(--font-mono, ui-monospace, monospace);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.55rem 0.95rem;
    border-radius: 999px;
    cursor: pointer;
    transition: all 120ms ease-out;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .filter-pill:hover {
    border-color: var(--color-fg, #0A0A0A);
    color: var(--color-fg, #0A0A0A);
  }

  .filter-pill:focus-visible {
    outline: 2px solid var(--color-accent, #0050F5);
    outline-offset: 2px;
  }

  .filter-pill.is-active {
    background: var(--color-fg, #0A0A0A);
    color: var(--color-bg, #FAFAFA);
    border-color: var(--color-fg, #0A0A0A);
  }

  .filter-count {
    font-size: 0.7rem;
    opacity: 0.7;
    font-variant-numeric: tabular-nums;
  }

  /* Hide entries that don't match the active filter. Client-side
     toggling, no rebuild required. */
  .entry[hidden] { display: none !important; }

  .filter-empty {
    color: var(--color-fg-muted, #525252);
    font-style: italic;
    margin-top: 1rem;
  }
</style>

<script is:inline>
  // Tiny client-side filter. Reads data-filter from the clicked pill,
  // toggles `hidden` on every .entry whose data-kind doesn't match.
  // No framework, no hydration cost — runs once on DOMContentLoaded.
  (function () {
    function init() {
      var pills = document.querySelectorAll('.filter-pill');
      var entries = document.querySelectorAll('#writing-list .entry');
      var empty = document.getElementById('filter-empty');
      if (!pills.length || !entries.length) return;

      function apply(kind) {
        var visible = 0;
        entries.forEach(function (el) {
          var match = kind === 'all' || el.getAttribute('data-kind') === kind;
          if (match) { el.removeAttribute('hidden'); visible++; }
          else { el.setAttribute('hidden', ''); }
        });
        if (empty) {
          if (visible === 0) empty.removeAttribute('hidden');
          else empty.setAttribute('hidden', '');
        }
        pills.forEach(function (p) {
          var on = p.getAttribute('data-filter') === kind;
          p.classList.toggle('is-active', on);
          p.setAttribute('aria-pressed', on ? 'true' : 'false');
        });
        // Reflect in URL hash so the filter survives a refresh + share.
        try {
          if (kind === 'all') history.replaceState(null, '', location.pathname + location.search);
          else history.replaceState(null, '', '#' + kind);
        } catch (e) {}
      }

      pills.forEach(function (p) {
        p.addEventListener('click', function () {
          apply(p.getAttribute('data-filter') || 'all');
        });
      });

      // Read initial filter from URL hash (e.g. /writing#project).
      var hash = (location.hash || '').replace('#', '');
      if (hash === 'essay' || hash === 'project') apply(hash);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>
