---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const BASE = import.meta.env.BASE_URL;

// Pull every non-draft essay, newest first.
const all = await getCollection('writing', ({ data }) => !data.draft);
const entries = all.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const fmtDate = (d: Date) =>
  d.toISOString().slice(0, 10); // YYYY-MM-DD; sentence-case-friendly

// Filter pill counts. Computed at build time; rendered once.
const counts = {
  all: entries.length,
  essay: entries.filter((e) => e.data.kind === 'essay').length,
  project: entries.filter((e) => e.data.kind === 'project').length,
};
---
<BaseLayout
  title="Writing — Field Notes"
  description="Field Notes — long-form essays on shipping software with AI agents. Plan-of-record, evidence layers, agent runtimes, and the anti-patterns engineering teams ship when a model is in the loop."
  lede="Field Notes. Long-form essays on shipping software with AI agents — plan-of-record, evidence layers, agent runtimes, and the anti-patterns engineering teams ship when a model is in the loop."
  nav="writing"
  ogImage="writing"
>
  {entries.length === 0 ? (
    <section class="prose">
      <p>No essays yet. The first ones land here.</p>
    </section>
  ) : (
    <>
      <div class="filter-bar" role="group" aria-label="Filter posts by kind">
        <button type="button" class="filter-pill is-active" data-filter="all" aria-pressed="true">
          All <span class="filter-count">{counts.all}</span>
        </button>
        <button type="button" class="filter-pill" data-filter="essay" aria-pressed="false">
          Essays <span class="filter-count">{counts.essay}</span>
        </button>
        <button type="button" class="filter-pill" data-filter="project" aria-pressed="false">
          Projects <span class="filter-count">{counts.project}</span>
        </button>
      </div>

      {/* Direction-C essay rows: white card, hairline-divided rows,
          kinetic cobalt underline on hover. */}
      <div class="essay-rows" id="writing-list">
        {entries.map((e) => (
          <a class="essay-row" href={`${BASE}writing/${e.id}`} data-kind={e.data.kind}>
            <time datetime={fmtDate(e.data.date)}>{fmtDate(e.data.date)}</time>
            <div class="essay-row__body">
              <h3><span>{e.data.title}</span></h3>
              <p class="essay-row__summary">{e.data.summary}</p>
            </div>
            <span class="essay-row__min">
              {e.data.kind === 'project' ? (e.data.project ?? 'project') : `${e.data.readingMins ?? '—'} min`}
            </span>
          </a>
        ))}
      </div>

      <p class="filter-empty" id="filter-empty" hidden>
        No posts in this filter yet.
      </p>
    </>
  )}
</BaseLayout>

<style>
  /* Filter bar — pill row with counts, v1 pill geometry + cobalt accent. */
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 1.5rem;
  }

  .filter-pill {
    appearance: none;
    border: 1px solid var(--color-line, #E2E4E8);
    background: var(--color-bg-elevated, #FFFFFF);
    color: var(--color-fg-muted, #70757F);
    font: 500 0.85rem/1 var(--font-mono, ui-monospace, monospace);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.55rem 0.95rem;
    border-radius: var(--radius-pill, 999px);
    cursor: pointer;
    transition: all 120ms ease-out;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .filter-pill:hover {
    border-color: var(--color-accent, #2742F5);
    color: var(--color-accent, #2742F5);
  }

  .filter-pill:focus-visible {
    outline: 2px solid var(--color-accent, #2742F5);
    outline-offset: 2px;
  }

  .filter-pill.is-active {
    background: var(--color-bg-inverse, #16181D);
    color: var(--color-bg, #F2F3F5);
    border-color: var(--color-bg-inverse, #16181D);
  }

  .filter-count {
    font-size: 0.7rem;
    opacity: 0.7;
    font-variant-numeric: tabular-nums;
  }

  /* Hide entries that don't match the active filter. Client-side
     toggling, no rebuild required. */
  .essay-row[hidden] { display: none !important; }

  .filter-empty {
    color: var(--color-fg-muted, #70757F);
    font-style: italic;
    margin-top: 1rem;
  }
</style>

<script is:inline>
  // Tiny client-side filter. Reads data-filter from the clicked pill,
  // toggles `hidden` on every row whose data-kind doesn't match.
  // No framework, no hydration cost — runs once on DOMContentLoaded.
  (function () {
    function init() {
      var pills = document.querySelectorAll('.filter-pill');
      var entries = document.querySelectorAll('#writing-list .essay-row');
      var empty = document.getElementById('filter-empty');
      if (!pills.length || !entries.length) return;

      function apply(kind) {
        var visible = 0;
        entries.forEach(function (el) {
          var match = kind === 'all' || el.getAttribute('data-kind') === kind;
          if (match) { el.removeAttribute('hidden'); visible++; }
          else { el.setAttribute('hidden', ''); }
        });
        if (empty) {
          if (visible === 0) empty.removeAttribute('hidden');
          else empty.setAttribute('hidden', '');
        }
        pills.forEach(function (p) {
          var on = p.getAttribute('data-filter') === kind;
          p.classList.toggle('is-active', on);
          p.setAttribute('aria-pressed', on ? 'true' : 'false');
        });
        // Reflect in URL hash so the filter survives a refresh + share.
        try {
          if (kind === 'all') history.replaceState(null, '', location.pathname + location.search);
          else history.replaceState(null, '', '#' + kind);
        } catch (e) {}
      }

      pills.forEach(function (p) {
        p.addEventListener('click', function () {
          apply(p.getAttribute('data-filter') || 'all');
        });
      });

      // Read initial filter from URL hash (e.g. /writing#project).
      var hash = (location.hash || '').replace('#', '');
      if (hash === 'essay' || hash === 'project') apply(hash);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>
