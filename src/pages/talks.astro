---
import BaseLayout from '../layouts/BaseLayout.astro';
const BASE = import.meta.env.BASE_URL;

const talks = [
  // Example shape:
  // {
  //   title: 'Error-budget discipline at platform scale',
  //   venue: 'DORA Summit',
  //   date: '2026-09-15',
  //   slidesUrl: '#',
  //   videoUrl: '#',
  // },
];
---
<BaseLayout
  title="Talks"
  description="Conference talks and recordings when the room is right. Topics: AI-agent infrastructure, plan-of-record + evidence layers, deploy/release/launch decoupling, AI app security."
  lede="Conference talks and recordings when the room is right. Topics: AI-agent infrastructure, agent-runtime primitives, deploy/release/launch decoupling, AI app security."
  nav="talks"
  ogImage="talks"
>
  {talks.length === 0 ? (
    <section class="prose">
      <p>
        No talks listed yet — the first will land here after the next conference. Until then,
        the long-form versions of the talks I'm working up live in <a href={`${BASE}writing`}>Field Notes</a>.
      </p>
      <p>
        Speaker invitations welcome &mdash; <a href={`${BASE}contact`}>send the brief</a>.
        Topics I'm currently shaping into talks:
      </p>
      <ul>
        <li>An agent runtime is five primitives. Most fake at least three.</li>
        <li>Plan-of-record and evidence layer &mdash; the two memories your agent needs.</li>
        <li>Deploy. Release. Launch. Three calendars, three owners.</li>
        <li>The AI failure surface your security scanner can't see.</li>
      </ul>
    </section>
  ) : (
    <ol class="entry-list">
      {talks.map((t) => (
        <li class="entry">
          <div class="entry-meta">
            <span>TALK</span>
            <span>{t.venue}</span>
            <span>{t.date}</span>
          </div>
          <h2>{t.title}</h2>
          <p class="entry-summary">
            {t.slidesUrl && <a href={t.slidesUrl}>Slides</a>}
            {t.slidesUrl && t.videoUrl && ' · '}
            {t.videoUrl  && <a href={t.videoUrl}>Video</a>}
          </p>
        </li>
      ))}
    </ol>
  )}
</BaseLayout>
