---
import BaseLayout from '../layouts/BaseLayout.astro';
import { paid, projects } from '../data/projects';
const BASE = import.meta.env.BASE_URL;

// /work per brand docs/ia.md: what I built and do — OSS projects +
// hire-me surface. Absorbs the v0 /lab shelf and the /talks topics
// (speaking history lives here as a section now).
const pad = (n: number) => String(n).padStart(2, '0');

// Topics being shaped into talks — carried over from the v0 /talks
// page; replace with real venue/date/slides entries once recorded.
const speakingTopics = [
  'An agent runtime is five primitives. Most fake at least three.',
  'Plan-of-record and evidence layer — the two memories your agent needs.',
  'Deploy. Release. Launch. Three calendars, three owners.',
  'The AI failure surface your security scanner can’t see.',
];
---
<BaseLayout
  title="Work"
  description="What I build and do. One paid product on the Atlassian Marketplace, a dozen open-source Go libraries, talks in the making, and the Klarlabs studio."
  lede="What I build and do. One paid product (Armada, in the Atlassian Marketplace). The rest open source on GitHub. Most are Go."
  nav="work"
  ogImage="work"
>
  <h2 class="section-kicker">PAID <i>/ {pad(paid.length)}</i></h2>
  <div class="work-cards">
    {paid.map((p, i) => (
      <a class="work-card work-card--paid" href={`${BASE}${p.href}`}>
        <div class="work-card__num">
          <span><span class="work-card__badge">PAID</span> {pad(i + 1)}</span>
          <span class="work-card__dot"></span>
        </div>
        <h3>{p.title}</h3>
        <p>{p.summary}</p>
      </a>
    ))}
  </div>

  <h2 class="section-kicker">OPEN SOURCE <i>/ {pad(projects.length)}</i></h2>
  <div class="work-cards">
    {projects.map((p, i) => (
      <a class="work-card" href={p.href}>
        <div class="work-card__num">{pad(i + 1)} <span class="work-card__dot"></span></div>
        <h3>{p.title}</h3>
        <p class="work-card__status">{p.status}</p>
        <p>{p.summary}</p>
      </a>
    ))}
  </div>
  <p class="section-more-muted">
    Everything else (smaller utilities, abandoned experiments) lives at
    <a href="https://github.com/felixgeelhaar">github.com/felixgeelhaar</a>.
  </p>

  <h2 class="section-kicker">SPEAKING <i>/ TOPICS</i></h2>
  <section class="prose">
    <p>
      Conference talks and recordings when the room is right &mdash; AI-agent infrastructure,
      agent-runtime primitives, deploy/release/launch decoupling, AI app security. The first
      recording lands here after the next conference; the long-form versions live in
      <a href={`${BASE}writing`}>Field Notes</a>. Topics I&rsquo;m currently shaping into talks:
    </p>
    <ul>
      {speakingTopics.map((t) => <li>{t}</li>)}
    </ul>
    <p>
      Speaker invitations welcome &mdash; <a href="mailto:hello@felixgeelhaar.com">send the brief</a>.
    </p>
  </section>

  <h2 class="section-kicker">STUDIO <i>/ KLARLABS</i></h2>
  <a class="work-card work-card--studio" href="https://klarlabs.de" rel="noopener">
    <div class="work-card__num">klarlabs.de <span aria-hidden="true">↗</span></div>
    <h3>Klarlabs</h3>
    <p>
      The Munich studio behind most of the shelf above. Product engineering for
      AI-agent infrastructure — its own site, sitting next to this one.
    </p>
  </a>

  <h2 class="section-kicker">HIRE <i>/ CONTACT</i></h2>
  <section class="prose work-hire">
    <p>
      Working on agent infrastructure, platform topology, or an AI feature that has to hold up
      in production? Email is the fastest path:
      <a href="mailto:hello@felixgeelhaar.com">hello@felixgeelhaar.com</a>. One paragraph with
      the actual question beats a long brief.
    </p>
  </section>
</BaseLayout>

<style>
  .work-card__badge {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-weight: 500;
    letter-spacing: 0.1em;
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-pill, 999px);
    background: var(--color-accent, #2742F5);
    color: var(--color-accent-fg, #FFFFFF);
    font-size: 0.7rem;
    margin-right: 0.4rem;
  }
  .work-card__status {
    font: 500 12px/1 var(--font-mono, ui-monospace, monospace);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-fg-muted, #70757F);
    margin: 0 0 0.5rem;
  }
  .work-card--studio { display: block; max-width: 36rem; }

  .section-more-muted {
    margin: 1.25rem 0 0;
    font-size: 0.9rem;
    color: var(--color-fg-muted, #70757F);
  }
  .work-hire p { max-width: 60ch; }
</style>
