<?xml version="1.0" encoding="UTF-8"?>
<!--
  Sitemap template. The SSG iterates content frontmatter and emits one
  <url> per route. lastmod is the file's last git commit date (use
  `git log -1 --format=%ad --date=iso-strict $path`). Static routes
  (/, /about, /now, /uses, /contact) carry the build date.

  This file is the contract; the generated /sitemap.xml replaces it on
  every build. Keep this template in sync when route shape changes
  (docs/ia.md is the source of truth).
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://felixgeelhaar.com/</loc>
    <lastmod>2026-05-16</lastmod>
    <changefreq>monthly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://felixgeelhaar.com/writing</loc>
    <lastmod>2026-05-16</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.9</priority>
  </url>
  <url>
    <loc>https://felixgeelhaar.com/lab</loc>
    <lastmod>2026-05-16</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.9</priority>
  </url>
  <url>
    <loc>https://felixgeelhaar.com/talks</loc>
    <lastmod>2026-05-16</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>
  <url>
    <loc>https://felixgeelhaar.com/about</loc>
    <lastmod>2026-05-16</lastmod>
