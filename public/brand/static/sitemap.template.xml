  <!--
    Per-post entries follow this shape; SSG renders one per content file:

    <url>
      <loc>https://felixgeelhaar.com/writing/$slug</loc>
      <lastmod>$gitDate</lastmod>
      <changefreq>monthly</changefreq>
      <priority>0.7</priority>
    </url>
  -->
</urlset>
